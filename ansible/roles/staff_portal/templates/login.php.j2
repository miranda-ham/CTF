<?php
session_start();
$error = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $username = $_POST['username'];
    $password = $_POST['password'];
    // VULNERABLE: string concatenation, no parameterised queries
    // MySQL errors returned to client to aid SQL injection enumeration
    $conn = new mysqli('localhost', '{{ portal_db_user }}', '{{ portal_db_password }}', 'bluewater_internal');
    if ($conn->connect_error) {
        die('Connection failed: ' . $conn->connect_error);
    }
    $query = "SELECT * FROM staff WHERE username='" . $username . "' AND password='" . $password . "'";
    $result = $conn->query($query);
    if ($result === false) {
        // Return DB errors to client - aids blind SQLi
        $error = 'Query error: ' . $conn->error;
    } elseif ($result->num_rows > 0) {
        $_SESSION['logged_in'] = true;
        header('Location: /search.php');
        exit;
    } else {
        $error = 'Invalid credentials.';
    }
}
