<?php
session_start();
if (!isset($_SESSION['logged_in']) || !$_SESSION['logged_in']) {
    header('Location: /login.php');
    exit;
}
$conn = new mysqli('localhost', '{{ portal_db_user }}', '{{ portal_db_password }}', 'bluewater_internal');
if ($conn->connect_error) {
    die('Connection failed: ' . $conn->connect_error);
}
$results = [];
$error = '';
$searched = false;
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['diver_name'])) {
    $searched = true;
    $diver_name = $_POST['diver_name'];
    // VULNERABLE: unparameterised query on dive_records table
    // UNION-based injection can reach staff table
    // e.g. ' UNION SELECT id,username,password,role,ssh_password FROM staff-- -
    $query = "SELECT dive_id, diver_name, certification, max_depth_m, incident_flag 
              FROM dive_records WHERE diver_name='" . $diver_name . "'";
    $result = $conn->query($query);
    if ($result === false) {
        // Errors visible to client - aids enumeration
        $error = 'Query error: ' . $conn->error;
    } else {
        while ($row = $result->fetch_assoc()) {
            $results[] = $row;
        }
    }
}
