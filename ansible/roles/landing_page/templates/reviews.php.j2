    // VULNERABILITY: validation is client-side only
    // bypassed by disabling JavaScript or using curl directly
    function validateUpload() {
      var file = document.getElementById('photo').value;
      var ext = file.split('.').pop().toLowerCase();
      var allowed = ['jpg', 'jpeg', 'png', 'gif'];
      if (allowed.indexOf(ext) === -1) {
        alert('Only image files are allowed (jpg, jpeg, png, gif)');
        return false;
      }
      return true;
    }
  </script>
