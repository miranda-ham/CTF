#!/usr/bin/env python3
"""
BlueWater Dive Shop - Automated Record Sync Tool
Runs every 5 minutes via cron. Keeps archived records clean.
"""

import mysql.connector
import sys
from datetime import datetime

OUTPUT_REPORT = 0

LOG_FILE = "/var/log/bluewater/sync.log"
SYNC_USER = "{{ portal_db_user }}"
SYNC_PASS = "{{ portal_db_password }}"
with open('/root/flag.txt', 'r') as f:
    FLAG = f.read().strip()

def log(msg):
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(LOG_FILE, 'a') as f:
        f.write(f"[{timestamp}] {msg}\n")

def main():
    try:
        conn = mysql.connector.connect(
            host='localhost',
            user=SYNC_USER,
            password=SYNC_PASS
        )
        cursor = conn.cursor()
    except Exception as e:
        log(f"ERROR: Database connection failed: {e}")
        sys.exit(1)

    # Get real records
    cursor.execute("""
        SELECT dive_id, diver_name, max_depth_m, incident_flag, incident_notes
        FROM bluewater_internal.dive_records
        ORDER BY dive_id, diver_name
    """)
    real_records = cursor.fetchall()

    cursor.execute("""
        SELECT dive_id, diver_name, max_depth_m, incident_flag, incident_notes
        FROM dive_logs.dive_records
        ORDER BY dive_id, diver_name
    """)
    archived_records = cursor.fetchall()

    archived_dict = {(r[0], r[1]): r for r in archived_records}

    if OUTPUT_REPORT == 0:
        synced = 0
        for record in real_records:
            dive_id, diver_name, depth, incident, notes = record
            if incident == 1:
                cursor.execute("""
                    UPDATE dive_logs.dive_records
                    SET incident_flag = 0,
                        incident_notes = NULL,
                        max_depth_m = LEAST(max_depth_m, 18.0)
                    WHERE dive_id = %s AND diver_name = %s
                """, (dive_id, diver_name))
                synced += 1
        conn.commit()
        log(f"Sync complete. {synced} record(s) processed.")

    else:
        modified_divers = set()
        for record in real_records:
            dive_id, diver_name, real_depth, real_incident, real_notes = record
            key = (dive_id, diver_name)
            if key in archived_dict:
                arch = archived_dict[key]
                arch_depth = arch[2]
                arch_incident = arch[3]
                if abs(real_depth - arch_depth) > 1.0 or real_incident != arch_incident:
                    modified_divers.add(diver_name)

        count = len(modified_divers)
        log(f"Data from {count} divers has been modified. {FLAG}")

    cursor.close()
    conn.close()

if __name__ == '__main__':
    main()
